---
import { getCollection } from 'astro:content';
const talks = await getCollection('speaking');
const sorted = talks.sort((a, b) => b.data.year - a.data.year);
---

<section id="speaking">
  <div class="container">
    <p class="section-label">Speaking</p>
    <h2 class="speaking-heading">On stage.</h2>
    <p class="speaking-sub">
      I speak on developer ecosystems, technical workshops, community building at scale, and the future of tech in Africa. 
      Available for conferences, panels, and keynotes.
    </p>

    <div class="talks-list">
      {sorted.map((t, i) => (
        <div class="talk-row" data-index={i}>
          <span class="talk-year">{t.data.year}</span>
          <div class="talk-info">
            <p class="talk-event">{t.data.event}</p>
            <p class="talk-topic">{t.data.topic}</p>
          </div>
          <div class="talk-meta">
            <span class="talk-role">{t.data.role}</span>
            <span class="talk-location">{t.data.location}</span>
          </div>
        </div>
      ))}
    </div>

    {sorted.length > 5 && (
      <button class="show-more-btn" id="speaking-toggle">
        Show {sorted.length - 5} more →
      </button>
    )}

    <div class="speaking-cta">
      <p>Want me to speak at your event?</p>
      <a href="/speaker-kit" class="btn-ghost">View speaker kit →</a>
      <a href="mailto:sodiq.akinjobi@gmail.com" class="btn-primary">Invite me to speak</a>
    </div>
  </div>
</section>

<style>
.speaking-heading {
  font-size: clamp(1.6rem, 3vw, 2.2rem);
  margin-bottom: 0.75rem;
}

.speaking-sub {
  color: var(--color-text-muted);
  max-width: 520px;
  margin-bottom: 2.5rem;
  font-size: 0.95rem;
}

.talks-list {
  display: flex;
  flex-direction: column;
  border-top: 1px solid var(--color-border);
  margin-bottom: 1.5rem;
}

.talk-row[data-index="5"],
.talk-row[data-index="6"],
.talk-row[data-index="7"],
.talk-row[data-index="8"],
.talk-row[data-index="9"],
.talk-row[data-index="10"],
.talk-row[data-index="11"],
.talk-row[data-index="12"] {
  display: none;
}

.talks-list.expanded .talk-row {
  display: grid;
}

.show-more-btn {
  background: none;
  border: 1px solid var(--color-border);
  color: var(--color-text-muted);
  font-family: var(--font-display);
  font-size: 0.8rem;
  padding: 0.6rem 1.25rem;
  border-radius: 4px;
  cursor: pointer;
  margin-bottom: 3rem;
  transition: color 0.2s, border-color 0.2s;
}

.show-more-btn:hover {
  color: var(--color-text);
  border-color: rgba(240, 236, 228, 0.3);
}

.talk-row {
  display: grid;
  grid-template-columns: 60px 1fr auto;
  gap: 1.5rem;
  align-items: center;
  padding: 1.25rem 0;
  border-bottom: 1px solid var(--color-border);
}

.talk-year {
  font-family: var(--font-display);
  font-size: 0.75rem;
  color: var(--color-text-muted);
  letter-spacing: 0.06em;
}

.talk-event {
  font-family: var(--font-display);
  font-weight: 600;
  font-size: 0.9rem;
  margin-bottom: 0.2rem;
}

.talk-topic {
  font-size: 0.8rem;
  color: var(--color-text-muted);
}

.talk-meta {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 0.2rem;
  text-align: right;
}

.talk-role {
  font-size: 0.75rem;
  font-family: var(--font-display);
  color: var(--color-accent);
}

.talk-location {
  font-size: 0.72rem;
  color: var(--color-text-muted);
}

.speaking-cta {
  display: flex;
  align-items: center;
  gap: 1rem;
  flex-wrap: wrap;
}

.speaking-cta p {
  color: var(--color-text-muted);
  font-size: 0.9rem;
  margin-right: 0.5rem;
}

.btn-primary {
  font-family: var(--font-display);
  font-weight: 600;
  font-size: 0.875rem;
  padding: 0.65rem 1.5rem;
  background: var(--color-accent);
  color: var(--color-bg);
  border-radius: 4px;
  transition: opacity 0.2s;
}

.btn-primary:hover { opacity: 0.88; }

.btn-ghost {
  font-family: var(--font-display);
  font-weight: 500;
  font-size: 0.875rem;
  padding: 0.65rem 1.25rem;
  border: 1px solid var(--color-border);
  border-radius: 4px;
  color: var(--color-text-muted);
  transition: color 0.2s, border-color 0.2s;
}

.btn-ghost:hover {
  color: var(--color-text);
  border-color: rgba(240, 236, 228, 0.3);
}

<script>
  const btn = document.getElementById('speaking-toggle');
  const list = btn?.previousElementSibling;
  if (btn && list) {
    const total = list.querySelectorAll('.talk-row').length;
    btn.addEventListener('click', () => {
      const expanded = list.classList.toggle('expanded');
      btn.textContent = expanded ? '← Show less' : `Show ${total - 5} more →`;
    });
  }
</script>

@media (max-width: 600px) {
  .talk-row {
    grid-template-columns: 50px 1fr;
    grid-template-rows: auto auto;
  }
  .talk-meta {
    grid-column: 2;
    align-items: flex-start;
    text-align: left;
    flex-direction: row;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
}
</style>

---
const socials = [
  { label: 'LinkedIn', href: 'https://linkedin.com/in/geektutor' },
  { label: 'X / Twitter', href: 'https://twitter.com/geektutor' },
  { label: 'GitHub', href: 'https://github.com/geektutor' },
];
---

<section id="contact">
  <div class="container contact-inner">
    <p class="section-label">Contact</p>
    <h2>Let's work together.</h2>
    <p class="contact-sub">
      Whether you're looking for a speaker, want to discuss developer programs in Africa, 
      or are building something interesting — my inbox is open.
    </p>
    <a href="mailto:sodiq.akinjobi@gmail.com" class="contact-email">
      sodiq.akinjobi@gmail.com
    </a>
    <div class="socials">
      {socials.map(s => (
        <a href={s.href} target="_blank" rel="noopener" class="social-link">
          {s.label} ↗
        </a>
      ))}
    </div>
  </div>
</section>

<style>
.contact-inner {
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
  max-width: 600px;
}

.contact-inner h2 {
  font-size: clamp(1.8rem, 3vw, 2.4rem);
  margin-top: 0.25rem;
}

.contact-sub {
  color: var(--color-text-muted);
  line-height: 1.8;
  font-size: 0.95rem;
}

.contact-email {
  font-family: var(--font-display);
  font-size: 1.1rem;
  font-weight: 600;
  color: var(--color-accent);
  transition: opacity 0.2s;
}

.contact-email:hover { opacity: 0.75; }

.socials {
  display: flex;
  gap: 1.5rem;
  flex-wrap: wrap;
  margin-top: 0.25rem;
}

.social-link {
  font-size: 0.85rem;
  font-family: var(--font-display);
  color: var(--color-text-muted);
  transition: color 0.2s;
}

.social-link:hover { color: var(--color-text); }
</style>

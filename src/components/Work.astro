---
const roles = [
  {
    company: 'Google',
    title: 'Developer Ecosystem Community Manager',
    period: '2023 — Present',
    description: 'Supporting Google Developer Groups in 31 Sub-Saharan African countries. Designing and scaling programs that reach 200,000+ developers annually through events, hackathons, and community initiatives.',
    tags: ['Program Management', 'Developer Relations', 'Africa'],
  },
  {
    company: 'API Conference Lagos',
    title: 'Founder & Organizer',
    period: '2022 — Present',
    description: "Building Nigeria's premier API and developer conference at the intersection of engineering, product, and business. The event brings together Africa's top technical voices each year.",
    tags: ['Events', 'Community', 'Technical Conferences'],
  },
  {
    company: 'Web3 Afrika',
    title: 'Event Program Manager',
    period: '2022 — Present',
    description: 'Web3 Afrika empowers Africans to lead in Web3 through education, opportunities, and community.',
    tags: ['Web3', 'Education', 'Blockchain'],
  },
  {
    company: 'Credo',
    title: 'Developer Community Relations Officer',
    period: 'Dec 2021 — Jun 2022',
    location: 'Lagos, Nigeria',
    description: 'Led developer community engagement and documentation strategy, reducing onboarding friction and growing developer participation through events, hackathons, and structured education content.',
    tags: ['Developer Relations', 'Community', 'Documentation'],
  },
  {
    company: 'Unilag Consult',
    title: 'Product Manager',
    period: 'Apr 2021 — Sep 2021',
    location: 'Lagos, Nigeria',
    description: 'Managed QA, technical documentation, and internal tooling for company products, driving a 25% improvement in team efficiency and stronger user adoption through market research and user feedback.',
    tags: ['Product Management', 'QA', 'Operations'],
  },
];
---

<section id="work">
  <div class="container">
    <p class="section-label">Experience</p>
    <h2 class="work-heading">Where I've built.</h2>

    <div class="timeline">
      {roles.map((role, i) => (
        <div class="role-card">
          <div class="role-meta">
            <span class="role-period">{role.period}</span>
            {role.location && <span class="role-location">{role.location}</span>}
          </div>
          <div class="role-body">
            <p class="role-company">{role.company}</p>
            <h3 class="role-title">{role.title}</h3>
            <p class="role-desc">{role.description}</p>
            <div class="role-tags">
              {role.tags.map(t => <span class="tag">{t}</span>)}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
.work-heading {
  font-size: clamp(1.6rem, 3vw, 2.2rem);
  margin-bottom: 3rem;
}

.timeline {
  display: flex;
  flex-direction: column;
  gap: 0;
  border-left: 1px solid var(--color-border);
  margin-left: 1rem;
}

.role-card {
  display: grid;
  grid-template-columns: 140px 1fr;
  gap: 2rem;
  padding: 2rem 0 2rem 2.5rem;
  position: relative;
  border-bottom: 1px solid var(--color-border);
}

.role-card:last-child { border-bottom: none; }

.role-card::before {
  content: '';
  position: absolute;
  left: -5px;
  top: 2.4rem;
  width: 9px;
  height: 9px;
  border-radius: 50%;
  background: var(--color-accent);
  border: 2px solid var(--color-bg);
}

.role-meta {
  padding-top: 0.2rem;
}

.role-period {
  font-size: 0.75rem;
  font-family: var(--font-display);
  color: var(--color-text-muted);
  letter-spacing: 0.04em;
}

.role-company {
  font-size: 0.75rem;
  font-family: var(--font-display);
  color: var(--color-accent);
  letter-spacing: 0.06em;
  text-transform: uppercase;
  margin-bottom: 0.3rem;
}

.role-title {
  font-size: 1.1rem;
  font-weight: 600;
  margin-bottom: 0.75rem;
}

.role-desc {
  color: var(--color-text-muted);
  font-size: 0.9rem;
  line-height: 1.75;
  margin-bottom: 1rem;
}

.role-location {
  display: block;
  font-size: 0.7rem;
  font-family: var(--font-display);
  color: var(--color-text-muted);
  letter-spacing: 0.03em;
  margin-top: 0.3rem;
  opacity: 0.7;
}


.role-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 0.4rem;
}

.tag {
  font-size: 0.7rem;
  font-family: var(--font-display);
  padding: 0.2rem 0.65rem;
  border: 1px solid var(--color-border);
  border-radius: 3px;
  color: var(--color-text-muted);
  letter-spacing: 0.03em;
}

@media (max-width: 600px) {
  .role-card {
    grid-template-columns: 1fr;
    gap: 0.5rem;
    padding-left: 1.75rem;
  }
  .role-meta { padding-top: 0; }
}
</style>
